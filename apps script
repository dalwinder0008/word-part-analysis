function processSearchTerms() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getActiveSheet();
  const data = sheet.getDataRange().getValues();

  const stopWords = new Set([
    "how", "to", "a", "an", "the", "in", "of", "for", "on", "kaise", "kare", "me", "ke", "ki", "near",
  ]);


  const output = [["Main Word", "Impr.", "Clicks", "Cost", "Conversions"]];

 
  for (let r = 1; r < data.length; r++) {
    const row = data[r];
    const searchTerm = String(row[0] || "").toLowerCase().trim();

    if (!searchTerm) continue;

    let mainWord = "";
    const words = searchTerm.split(/\s+/);
    
    for (let w = 0; w < words.length; w++) {
      // \u0900-\u097F Hindi (Devanagari) characters ko preserve karta hai
      const cleanWord = words[w].replace(/[^\w\u0900-\u097F]/g, "");
      
      // Stop word aur pure numbers ko skip karke pehla valid word nikalna
      if (cleanWord && !stopWords.has(cleanWord) && isNaN(cleanWord)) {
        mainWord = cleanWord;
        break;
      }
    }
    
    if (!mainWord && words[0]) {
      mainWord = words[0].replace(/[^\w\u0900-\u097F]/g, "");
    }

    const impr = Number(String(row[5] || 0).replace(/[^\d.]/g, "")) || 0;
    const clicks = Number(String(row[6] || 0).replace(/[^\d.]/g, "")) || 0;
    const cost = Number(String(row[8] || 0).replace(/[^\d.]/g, "")) || 0;
    const conv = Number(String(row[9] || 0).replace(/[^\d.]/g, "")) || 0;

    output.push([mainWord, impr, clicks, cost, conv]);
  }


  let outputSheet = ss.getSheetByName("One Word Analysis");
  if (!outputSheet) {
    outputSheet = ss.insertSheet("One Word Analysis");
  } else {
    outputSheet.clear();
  }

  
  outputSheet.getRange(1, 1, output.length, output[0].length).setValues(output);
  outputSheet.getRange(1, 1, 1, output[0].length).setFontWeight("bold").setBackground("#e8e8e8");
  outputSheet.setFrozenRows(1);

  SpreadsheetApp.getUi().alert("Done! One Word Analysis");
}
