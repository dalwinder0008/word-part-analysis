function extractAndCreateNewFile() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return;

  const data = sheet.getRange(2, 1, lastRow - 1, 12).getValues();

  const stopWords = new Set([
    "how", "to", "a", "an", "the", "in", "of", "for", "on", "with", "is", "at", "by", "from", 
    "and", "or", "what", "which", "best", "top", "small", "business", "ideas", "kaise", "kare", 
    "me", "main", "ko", "se", "ke", "ki"
  ]);


  const outputData = data.map(row => {
    const phrase = row[0].toString().toLowerCase().trim();
    const words = phrase.split(/\s+/);
    
    let mainWord = words.find(w => {
      const clean = w.replace(/[^\p{L}\p{N}]/gu, "");
      return clean && !stopWords.has(clean);
    }) || words[0] || "";

    mainWord = mainWord.replace(/[^\p{L}\p{N}]/gu, "");

    return [mainWord, row[5], row[6], row[8], row[11]];
  });

  const newSpreadsheet = SpreadsheetApp.create("OneWord_Report_" + new Date().toLocaleDateString());
  const newSheet = newSpreadsheet.getActiveSheet();

  newSheet.getRange(1, 1, 1, 5).setValues([["Main Word", "Impr.", "Clicks", "Cost", "Conv. rate"]]);
  newSheet.getRange(2, 1, outputData.length, 5).setValues(outputData);


const fileUrl = newSpreadsheet.getUrl();
const html = `<p><a href="${fileUrl}" target="_blank">Click Here to Open New File</a></p>`;

SpreadsheetApp.getUi().showModalDialog(
  HtmlService.createHtmlOutput(html).setWidth(300).setHeight(80), 
  "New File Link"
);
}
